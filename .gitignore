# Mac OS
.DS_Store

# NPM
/node_modules
npm-*

# Testing
/.nyc_output
/coverage

# Build
/build
/dist
/.opt-in

# Generated translation files
/translations
/locale

# Other generated source
/src/generated

# Downloaded during "npm install"
/static/microbit

# for act
.secrets

# WorkBuddy 本地数据（不提交）
/.workbuddy

# 插件仓库（独立 git，已推 GitHub dhdbvcg/scratch-ext-addon）
/outputs

# 保留桌面打包配置（手写的，非生成产物；排除生成的 bundle/安装包）
!/build/
/build/*
!/build/main.js
!/build/package.json
!/build/installer.nsh
# 插件运行时：build/ 里手写的源（不是 electron-builder 的产物），
# 打包时必须一起带上，否则 exe 起来后 require('./ext-plugin-runtime') 直接失败。
#
# 这里**没有** build/plugins-src —— 内置插件已全部外置，插件本体住在各自的
# GitHub 仓库，由用户从「设置 → 插件市场」安装，不再随编辑器分发。
!/build/ext-plugin-runtime.js

# ── 开源发布前的保密/大文件规则 ──

# 明文凭据（绝不提交）
/apikey.md

# 语音识别运行时与 SenseVoice 模型（体积大，按 README「语音输入」章节自行获取）
/voice
/voice-models
/voice-runtime

# 本地日志 / 缓存 / 构建产物 / 系统垃圾
/.dev-server.log
/.wrangler
/build-release.zip
/installer_out
/nul
Thumbs.db

# ── 体积超限 / 本地临时产物 ──

# 语音识别打包产物（单文件 161MB，超过 GitHub 100MB 硬上限；
# 需要时按 README「语音输入」章节自行获取）
/voice-web-pkg

# 本地开发日志
/devserver.log
/devserver.err.log

# 编辑器里手工留下的样式备份
*.css.keep
