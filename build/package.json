{
  "name": "scratch-extension-editor",
  "version": "0.2.13671891",
  "description": "scratch扩展编辑器",
  "main": "main.js",
  "author": "dhdbvcg",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.scratchextensioneditor.editor",
    "productName": "scratch-extension-editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": false,
      "allowElevation": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3"
  }
}
